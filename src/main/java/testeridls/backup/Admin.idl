    #include "Common.idl"

    module AdminService {

        interface Admin {
            boolean addUser(in string token, in string username, in string password);
            //CommonTypes::topUsers getUsers(in string token);
            void updateUser(in string token, in string userId, in CommonTypes::User newInfo);
            void deleteUser(in string token, in string userId);
