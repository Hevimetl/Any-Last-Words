<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="910" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
      <ImageView fitHeight="912.0" fitWidth="1314.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/User_Menu.png" />
         </image>
      </ImageView>
        <Button fx:id="userButton" layoutX="38.0" layoutY="139.0" mnemonicParsing="false" prefHeight="21.0" prefWidth="134.0" style="-fx-background-color: trans;">
         <graphic>
            <ImageView fitHeight="23.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/UserAdmin_Button.png" />
               </image>
            </ImageView>
         </graphic></Button>
        <Button fx:id="settingsButton" layoutX="202.0" layoutY="138.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="140.0" style="-fx-background-color: trans;">
         <graphic>
            <ImageView fitHeight="21.0" fitWidth="163.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/SettingsAdmin_Button.png" />
               </image>
            </ImageView>
         </graphic></Button>
        <Button fx:id="manageButton" layoutX="369.0" layoutY="138.0" mnemonicParsing="false" prefHeight="31.0" prefWidth="143.0" style="-fx-background-color: trans;">
         <graphic>
            <ImageView fitHeight="23.0" fitWidth="139.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/ManageAdmin_Button.png" />
               </image>
            </ImageView>
         </graphic></Button>
        <TableView fx:id="userTable" layoutX="76.0" layoutY="251.0" prefHeight="593.0" prefWidth="1114.0">
            <columns>
                <TableColumn fx:id="userIdColumn" prefWidth="97.0" resizable="false" text="User ID" />
                <TableColumn fx:id="usernameColumn" prefWidth="346.0" text="Username" />
                <TableColumn fx:id="passwordColumn" prefWidth="366.0" text="Password" />
                <TableColumn fx:id="winsColumn" prefWidth="117.0" text="Win Count" />
            </columns>
        </TableView>
        <TextField fx:id="searchField" layoutX="1041.0" layoutY="206.0" promptText="Search users..." />
    </children>
</AnchorPane>
