<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="910" prefWidth="1280.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Button fx:id="joinGame" layoutX="510.0" layoutY="340.0" mnemonicParsing="false" prefHeight="0.0" prefWidth="248.0" style="-fx-background-color: transparent;" textFill="WHITE">
         <font>
            <Font name="Yoster Island Regular" size="36.0" />
         </font>
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
         <graphic>
            <ImageView fx:id="joinImage" fitHeight="60.0" fitWidth="200.0">
               <image>
                  <Image url="@images/JoinGame_Base.png" />
               </image>
            </ImageView>
         </graphic></Button>
      <Button fx:id="createGame" layoutX="485.0" layoutY="470.0" mnemonicParsing="false" prefHeight="0.0" prefWidth="307.0" style="-fx-background-color: transparent;" textFill="WHITE">
         <font>
            <Font name="Yoster Island Regular" size="36.0" />
         </font>
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
         <graphic>
            <ImageView fx:id="createImage" fitHeight="60.0" fitWidth="259.0">
               <image>
                  <Image url="@images/CreateGame_Base.png" />
               </image>
            </ImageView>
         </graphic></Button>
      <Button fx:id="returnButton" layoutX="36.0" layoutY="37.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="90.0" style="-fx-background-color: ffffff0;">
         <graphic>
            <ImageView fx:id="returnImage" fitHeight="60.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/Return_Base.png" />
               </image>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
      </Button>
   </children>
</AnchorPane>
