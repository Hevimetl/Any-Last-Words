<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="910" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>

      <ImageView fitHeight="910.0" fitWidth="1280.0" layoutX="-19.0" layoutY="2.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <image>
            <Image url="@images/CharSelectionBG.png" />
         </image>
      </ImageView>

      <Button fx:id="returnButton" layoutX="46.0" layoutY="47.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="90.0" style="-fx-background-color: transparent;">
         <graphic>
            <ImageView fx:id="returnImage" fitHeight="60.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/Return_Base.png" />
               </image>
            </ImageView>
         </graphic>
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
      </Button>

      <!-- Leaderboard Table -->
      <TableView fx:id="leaderboardTable" layoutX="309.0" layoutY="144.0" prefHeight="640.0" prefWidth="680.0" style="-fx-background-color: black;">

         <!-- User ID Column -->
         <columns>
            <TableColumn fx:id="userIdColumn" prefWidth="150.0">
               <graphic>
                  <Label text="User ID">
                     <font>
                        <Font name="Yoster Island" size="20" />
                     </font>
                     <style>
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                     </style>
                  </Label>
               </graphic>
            </TableColumn>

            <!-- Username Column -->
            <TableColumn fx:id="usernameColumn" prefWidth="350.0">
               <graphic>
                  <Label text="Username">
                     <font>
                        <Font name="Yoster Island" size="20" />
                     </font>
                     <style>
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                     </style>
                  </Label>
               </graphic>
            </TableColumn>

            <!-- Wins Column -->
            <TableColumn fx:id="winsColumn" prefWidth="150.0">
               <graphic>
                  <Label text="Wins">
                     <font>
                        <Font name="Yoster Island" size="20" />
                     </font>
                     <style>
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                     </style>
                  </Label>
               </graphic>
            </TableColumn>
         </columns>
      </TableView>
   </children>
</AnchorPane>
